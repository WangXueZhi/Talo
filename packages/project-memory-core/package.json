{
  "name": "project-memory-core",
  "version": "0.14.0",
  "description": "Talo's platform-neutral local project memory core and offline project hub.",
  "type": "module",
  "private": true,
  "bin": {
    "talo": "./dist/talo.mjs",
    "project-memory": "./dist/project-memory.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./types": "./dist/types.mjs"
  },
  "scripts": {
    "build": "tsup && node scripts/build-browser.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-fcose": "^2.2.0",
    "ignore": "^7.0.5",
    "lucide-preact": "^1.24.0",
    "picomatch": "^4.0.3",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/cytoscape-dagre": "^2.3.3",
    "@types/node": "^24.10.0",
    "@types/picomatch": "^4.0.2",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
